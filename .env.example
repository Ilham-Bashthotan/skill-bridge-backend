# Environment Variables Template

# Database URL - Replace with your actual database connection string
# For Railway: This will be auto-generated when you add PostgreSQL service
# For local development: Use localhost with your local database
DATABASE_URL="postgresql://user:password@host:port/database"

# Application Environment
NODE_ENV="production"

# Application Port (Railway will set this automatically)
PORT=3001

# JWT Secret (add this if your app uses JWT authentication)
# JWT_SECRET="your-secret-key-here"

# Other environment variables your app might need
# Add any additional environment variables here